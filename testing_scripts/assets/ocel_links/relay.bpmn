<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Relay" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- a process with no tasks: every ItemPicked starts a case, which at once publishes Noted -->
  <bpmn:process id="Relay" isExecutable="false">
    <bpmn:startEvent id="Start_Picked" name="item picked"><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
    <bpmn:endEvent id="End_Noted" name="noted"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Picked" targetRef="End_Noted" />
  </bpmn:process>
</bpmn:definitions>
