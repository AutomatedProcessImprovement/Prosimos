<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Sales" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- the deadline model, with a parallel branch that withdraws the order after 2 h and ends the whole
       case at a terminate end event while the other branch is still racing the shipment against the timer -->
  <bpmn:process id="Sales" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order received"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Take_Order" name="Take order"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_OrderPlaced" name="Order placed"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="Split"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:eventBasedGateway id="Race"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Shipment" name="Shipment received"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Deadline" name="6 h"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:intermediateCatchEvent>
    <bpmn:task id="Close_Order" name="Close order"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Cancel_Order" name="Cancel order"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Withdraw_Order" name="Withdraw order"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="First_Done"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Order ended"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Take_Order" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Take_Order" targetRef="Throw_OrderPlaced" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Throw_OrderPlaced" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Split" targetRef="Race" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Race" targetRef="Catch_Shipment" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Race" targetRef="Deadline" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Catch_Shipment" targetRef="Close_Order" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Deadline" targetRef="Cancel_Order" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Close_Order" targetRef="First_Done" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Cancel_Order" targetRef="First_Done" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Split" targetRef="Withdraw_Order" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Withdraw_Order" targetRef="First_Done" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="First_Done" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
