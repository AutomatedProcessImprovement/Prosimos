<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Orders" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- warehouse orders: each is packed, then waits at the dock for a truck, which takes up to its
       capacity of waiting orders -->
  <bpmn:process id="Orders" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pack" name="Pack">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_Truck" name="Truck at the dock">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Truck_definition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Load" name="Load">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Shipped">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Pack" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Pack" targetRef="Catch_Truck" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Catch_Truck" targetRef="Load" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Load" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
