<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Sales" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- orders that announce each of their items: after Take order, one ItemOrdered per item -->
  <bpmn:process id="Sales" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order received"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Take_Order" name="Take order"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_Items" name="Items ordered"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End" name="Order placed"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Take_Order" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Take_Order" targetRef="Throw_Items" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Throw_Items" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
