<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Sales" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- the Sales model packing the order while it waits for the shipment: an AND split, then an AND join -->
  <bpmn:process id="Sales" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order received"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Take_Order" name="Take order"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_OrderPlaced" name="Order placed"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="Split"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Catch_Shipment" name="Shipment received"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
    <bpmn:task id="Pack_Order" name="Pack order"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="Join"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="Close_Order" name="Close order"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End" name="Order closed"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Take_Order" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Take_Order" targetRef="Throw_OrderPlaced" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Throw_OrderPlaced" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Split" targetRef="Catch_Shipment" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Split" targetRef="Pack_Order" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Catch_Shipment" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Pack_Order" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Join" targetRef="Close_Order" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Close_Order" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
